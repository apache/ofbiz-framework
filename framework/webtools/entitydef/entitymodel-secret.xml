<entitymodel xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://ofbiz.apache.org/dtds/entitymodel.xsd">
    <title>Secret Management Entities</title>
    <description>Entities for the OFBiz Secret Management audit trail.</description>
    <version>1.0</version>

    <!-- ========================================================= -->
    <!-- org.apache.ofbiz.webtools.secret                          -->
    <!-- ========================================================= -->

    <entity entity-name="SecretAuditLog"
            package-name="org.apache.ofbiz.webtools.secret"
            title="Immutable log of secret management access and admin events"
            never-cache="true">

        <!-- PK — sequenced, same two-step pattern as EntityAuditLog.auditHistorySeqId -->
        <field name="secretAuditLogId" type="id"/>

        <!-- When -->
        <field name="auditTimestamp" type="date-time"/>

        <!-- Who — userLoginId null for scheduler jobs; clientIpAddress null for non-HTTP call sites -->
        <!-- long-varchar for clientIpAddress: IPv6 needs up to 39 chars; short-varchar is VARCHAR(20) -->
        <field name="userLoginId" type="id-vlong"/>
        <field name="clientIpAddress" type="long-varchar"/>

        <!-- What secret — logical key name only, NEVER the value or vault path -->
        <field name="secretKeyRef" type="name">
            <description>Logical key name (e.g. jdbc-password.default). Never a vault path, ARN, or secret value.</description>
        </field>

        <!-- Where the secret lives in OFBiz storage -->
        <!-- Values: SYSTEM_PROPERTY | PASSWORDS_FILE | UNKNOWN -->
        <field name="secretTarget" type="name"/>

        <!-- What happened — col-name avoids the SQL reserved word ACTION -->
        <!-- Values: FETCH | CACHE_HIT | SYNC | STORE | FLUSH_CACHE | RESET_STATS |
                     RELOAD_PROVIDER | TEST_CONNECTION | ROTATION_POLL |
                     EXPORT_AUDIT | UPDATE_RETENTION | VIEW_STATS | PURGE | UNKNOWN -->
        <field name="action" col-name="AUDIT_ACTION" type="name"/>

        <!-- How the secret was accessed -->
        <!-- Values: PROVIDER_CALL | CACHE_HIT | FALLBACK_FILE | ENV_VAR | NOT_APPLICABLE -->
        <field name="accessMode" type="name"/>

        <!-- Which provider was active at audit-write time -->
        <!-- Values: AWS | AZURE | HASHICORP | GCP | BITWARDEN | ONEPASSWORD | ENV_VAR | FILE | NONE -->
        <field name="providerType" type="name"/>

        <!-- Architecture mode — read from secret.audit.deployment.mode at class load -->
        <!-- Values: DIRECT | K8S_INJECTED -->
        <field name="deploymentMode" type="name"/>

        <!-- Result -->
        <!-- Values: SUCCESS | PARTIAL_FAILURE | FAILURE | NOT_FOUND | DENIED | FALLBACK_USED | NO_CHANGE -->
        <field name="outcome" type="name"/>

        <!-- Safe error category — null unless outcome=FAILURE -->
        <!-- Values: AUTH_FAILED | NETWORK_TIMEOUT | PROVIDER_ERROR | INVALID_CONFIG -->
        <field name="errorCategory" type="short-varchar"/>

        <!-- SystemProperty coordinates — nullable; populated for SYNC / STORE / ROTATION_POLL -->
        <!-- No FK constraints: audit rows must survive deletion of the referenced property row -->
        <field name="systemResourceId" type="id-long"/>
        <field name="systemPropertyId" type="id-long"/>

        <prim-key field="secretAuditLogId"/>

        <!-- Indexes covering the common query patterns used by the Audit Log Viewer and purge job -->
        <index name="SECRET_AUDIT_TS">
            <index-field name="auditTimestamp"/>
        </index>
        <index name="SECRET_AUDIT_USER_TS">
            <index-field name="userLoginId"/>
            <index-field name="auditTimestamp"/>
        </index>
        <index name="SECRET_AUDIT_KEY_TS">
            <index-field name="secretKeyRef"/>
            <index-field name="auditTimestamp"/>
        </index>
        <index name="SECRET_AUDIT_ACTION_TS">
            <index-field name="action"/>
            <index-field name="auditTimestamp"/>
        </index>

    </entity>

</entitymodel>
