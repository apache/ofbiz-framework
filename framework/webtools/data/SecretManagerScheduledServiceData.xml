<entity-engine-xml>
    <!-- The following two elements set up a regularly scheduled job that automatically syncs
        SystemProperty-backed secrets from the active SecretProvider, picking up any rotation
        performed in the remote vault. The job is seeded so it is visible/manageable from the
        admin Scheduler screen, but autoSyncRotatedSecrets itself no-ops unless
        secret.rotation.autosync.enabled=true is set in security.properties (disabled by default). -->
    <TemporalExpression tempExprId="SECRET_AUTOSYNC" tempExprTypeId="FREQUENCY" description="Every Hour" integer1="12" integer2="60"/>
    <JobSandbox jobId="SECRET_AUTOSYNC" jobName="Auto-sync rotated secrets (SystemProperty)" runTime="2000-01-01 00:00:00.000" serviceName="autoSyncRotatedSecrets" poolId="pool" runAsUser="system" tempExprId="SECRET_AUTOSYNC" maxRecurrenceCount="-1"/>

    <!-- SecretAuditLog purge job — runs every 7 days starting 2000-01-02 02:00:00 (Sunday UTC).
         tempExprTypeId="FREQUENCY" uses Java Calendar constants for integer1:
           Calendar.DAY_OF_MONTH = 5.  integer2 = count of units → 7 = every 7 days. -->
    <TemporalExpression tempExprId="SECRET_AUDIT_PURGE" tempExprTypeId="FREQUENCY"
            description="Every 7 days (weekly purge)"
            date1="2000-01-02 02:00:00.000" integer1="5" integer2="7"/>
    <JobSandbox jobId="SECRET_AUDIT_PURGE" jobName="Purge expired SecretAuditLog rows"
            runTime="2000-01-02 02:00:00.000" serviceName="purgeExpiredSecretAuditLogs"
            poolId="pool" runAsUser="system" tempExprId="SECRET_AUDIT_PURGE" maxRecurrenceCount="-1"/>

    <!-- SecretAuditLog retention configuration — editable via the Audit Log Viewer screen.
         Retention period must be >= 365 days to satisfy PCI-DSS 4.0 requirement 10.7. -->
    <SystemProperty systemResourceId="security" systemPropertyId="secret.audit.retention.days"
            systemPropertyValue="365"
            description="Days to retain SecretAuditLog rows before the weekly purge job removes them (PCI-DSS minimum: 365)."/>
    <SystemProperty systemResourceId="security" systemPropertyId="secret.audit.purge.batch.size"
            systemPropertyValue="500"
            description="Maximum rows deleted per batch in purgeExpiredSecretAuditLogs to avoid long table locks on large installations."/>

</entity-engine-xml>
