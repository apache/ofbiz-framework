<entity-engine-xml>
    <!-- MFA challenge/audit-event purge job — runs daily at midnight. Pending/expired
         UserLoginAuthChallenge rows and old UserAuthenticationEvent audit rows otherwise accumulate
         forever, since nothing else ever deletes them. The service's own defaults
         (daysToKeepChallenges=1, daysToKeepEvents=90) apply since no explicit parameters are passed
         here.

         This defines its own TemporalExpression (same daily-midnight schedule as the shared
         MIDNIGHT_DAILY one in framework/service/data/ServiceSeedData.xml) instead of referencing it,
         because the security component loads before the service component
         (framework/base/config/component-load.xml): a JobSandbox row seeded here against
         MIDNIGHT_DAILY would fail the JOB_SNDBX_TEMPEXPR foreign key on a fresh load, since that row
         would not exist yet. Mirrors the same self-contained pattern already used for
         SECRET_AUDIT_PURGE in framework/webtools/data/SecretManagerScheduledServiceData.xml. -->
    <TemporalExpression tempExprId="MFA_CHALLENGE_PURGE" tempExprTypeId="FREQUENCY" description="Daily at Midnight"
            date1="2000-01-01 00:00:00.000" integer1="5" integer2="1"/>
    <JobSandbox jobId="MFA_CHALLENGE_PURGE" jobName="Purge old MFA challenges and authentication events"
            runTime="2000-01-01 00:00:00.000" serviceName="purgeOldMfaChallengesAndEvents"
            poolId="pool" runAsUser="system" tempExprId="MFA_CHALLENGE_PURGE" maxRecurrenceCount="-1"/>
</entity-engine-xml>
