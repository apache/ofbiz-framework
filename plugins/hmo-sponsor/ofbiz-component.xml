<!--
    hmo-sponsor — Corporate Sponsor Portal
    
    Provides the /hmosponsor webapp for HR/Admin staff at employer companies to:
      - Manage group HMO policies (HmoSponsorPolicy)
      - Enroll, suspend, and terminate employee enrollees (HmoEnrollmentRecord)
      - View monthly billing statements and utilisation reports
    
    Entity model defines: HmoSponsorPolicy, HmoEnrollmentRecord
    These entities are also referenced by hmo-provider and hmo-ehdsi.
-->
<ofbiz-component name="hmo-sponsor"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://ofbiz.apache.org/dtds/ofbiz-component.xsd">

    <resource-loader name="main" type="component"/>
    <classpath type="dir" location="config"/>

    <!-- Entity model: sponsor policy and enrollment record -->
    <entity-resource type="model" reader-name="main" loader="main" location="entitydef/entitymodel.xml"/>

    <!-- Service definitions -->
    <service-resource type="model" loader="main" location="servicedef/services.xml"/>

    <!--
        Sponsor Portal webapp
        base-permission="HMO_VIEW" — all sponsor security group users have HMO_VIEW.
    -->
    <webapp name="hmosponsor"
        title="HMO Sponsor Portal"
        position="23"
        description="HMO Corporate Sponsor Portal"
        server="default-server"
        location="webapp/hmosponsor"
        base-permission="HMO_VIEW"
        mount-point="/hmosponsor"
        app-bar-display="false"/>

</ofbiz-component>
