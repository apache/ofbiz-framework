<entitymodel xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://ofbiz.apache.org/dtds/entitymodel.xsd">
    <title>HMO Sponsor Entity Model</title>
    <description>Entity definitions for the HMO Sponsor plugin: group health plan
        policies and individual enrollment records.</description>
    <version>1.0</version>

    <!-- ================================================================ -->
    <!--  HmoSponsorPolicy                                                 -->
    <!--  A group health plan policy taken out by a corporate sponsor      -->
    <!--  (employer) on behalf of their employees.                        -->
    <!-- ================================================================ -->

    <entity entity-name="HmoSponsorPolicy"
            package-name="org.apache.ofbiz.hmo.sponsor"
            title="HMO Sponsor Policy">
        <field name="sponsorPolicyId"    type="id"/>
        <field name="partyId"            type="id">
            <description>The sponsor (employer) party</description>
        </field>
        <field name="planTierEnumId"     type="id">
            <description>HMO_PLAN_TIER enumeration (Bronze/Silver/Gold/Platinum)</description>
        </field>
        <field name="coverageTypeEnumId" type="id">
            <description>HMO_COVERAGE_TYPE enumeration</description>
        </field>
        <field name="fromDate"           type="date-time"/>
        <field name="thruDate"           type="date-time" optional="true"/>
        <field name="premiumAmount"      type="currency-amount"/>
        <field name="currencyUomId"      type="id-vlong"/>
        <field name="annualLimitAmount"  type="currency-amount" optional="true">
            <description>Per-enrollee annual benefit limit</description>
        </field>
        <field name="maxDependents"      type="numeric-long" optional="true">
            <description>Maximum number of dependents per principal enrollee</description>
        </field>
        <field name="description"        type="description" optional="true"/>
        <field name="statusId"           type="id">
            <description>HMO_ENROLL_STATUS (ACTIVE/EXPIRED/TERMINATED)</description>
        </field>

        <prim-key field="sponsorPolicyId"/>

        <relation type="one" fk-name="SPONPOL_PARTY" rel-entity-name="Party">
            <key-map field-name="partyId"/>
        </relation>
        <relation type="one" fk-name="SPONPOL_TIER" rel-entity-name="Enumeration">
            <key-map field-name="planTierEnumId" rel-field-name="enumId"/>
        </relation>
        <relation type="one" fk-name="SPONPOL_COV" rel-entity-name="Enumeration" title="CoverageType">
            <key-map field-name="coverageTypeEnumId" rel-field-name="enumId"/>
        </relation>
        <relation type="one" fk-name="SPONPOL_CURR" rel-entity-name="Uom">
            <key-map field-name="currencyUomId" rel-field-name="uomId"/>
        </relation>
        <relation type="one" fk-name="SPONPOL_STATUS" rel-entity-name="StatusItem">
            <key-map field-name="statusId"/>
        </relation>
        <relation type="many" fk-name="SPONPOL_ENROLLS" rel-entity-name="HmoEnrollmentRecord">
            <key-map field-name="sponsorPolicyId"/>
        </relation>
    </entity>

    <!-- ================================================================ -->
    <!--  HmoEnrollmentRecord                                              -->
    <!--  Tracks the formal enrollment of a person under an HMO plan.     -->
    <!--  Used by all three plugins: sponsor creates/manages, provider     -->
    <!--  reads for eligibility, member reads for self-service.            -->
    <!-- ================================================================ -->

    <entity entity-name="HmoEnrollmentRecord"
            package-name="org.apache.ofbiz.hmo.sponsor"
            title="HMO Enrollment Record">
        <field name="enrollmentId"           type="id"/>
        <field name="sponsorPolicyId"        type="id" optional="true">
            <description>Null for individual (non-employer) enrollees</description>
        </field>
        <field name="enrolleePartyId"        type="id">
            <description>The enrolled person (principal or dependent)</description>
        </field>
        <field name="primaryEnrolleePartyId" type="id" optional="true">
            <description>For dependents: the principal enrollee's partyId</description>
        </field>
        <field name="coverageTypeEnumId"     type="id">
            <description>HMO_COVERAGE_TYPE enumeration</description>
        </field>
        <field name="memberIdNumber"         type="id-long">
            <description>Printed on the member card; used by providers for eligibility checks</description>
        </field>
        <field name="fromDate"               type="date-time"/>
        <field name="thruDate"               type="date-time" optional="true"/>
        <field name="statusId"               type="id">
            <description>HMO_ENROLL_STATUS state machine</description>
        </field>
        <field name="groupId"                type="id-long" optional="true">
            <description>Employer group identifier used for billing aggregation</description>
        </field>

        <prim-key field="enrollmentId"/>

        <relation type="one" fk-name="ENRL_SPONPOL" rel-entity-name="HmoSponsorPolicy">
            <key-map field-name="sponsorPolicyId"/>
        </relation>
        <relation type="one" fk-name="ENRL_ENROLLEE" rel-entity-name="Party">
            <key-map field-name="enrolleePartyId" rel-field-name="partyId"/>
        </relation>
        <relation type="one" title="PrimaryEnrollee" fk-name="ENRL_PRIMARY" rel-entity-name="Party">
            <key-map field-name="primaryEnrolleePartyId" rel-field-name="partyId"/>
        </relation>
        <relation type="one" fk-name="ENRL_COV" rel-entity-name="Enumeration">
            <key-map field-name="coverageTypeEnumId" rel-field-name="enumId"/>
        </relation>
        <relation type="one" fk-name="ENRL_STATUS" rel-entity-name="StatusItem">
            <key-map field-name="statusId"/>
        </relation>
    </entity>

</entitymodel>
