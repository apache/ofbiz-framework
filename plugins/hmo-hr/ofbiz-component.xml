<!--
    hmo-hr — HMO HR & Admin Plugin

    Extends the OFBiz humanres application to manage HMO internal staff:
    employment lifecycle, grade levels, promotions, leave management.

    Depends on: humanres (OFBiz built-in human resources application)

    Entity model defines: HmoGradeLevel, HmoStaffPosition, HmoPromotion, HmoLeaveRecord
-->
<ofbiz-component name="hmo-hr"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://ofbiz.apache.org/dtds/ofbiz-component.xsd">

    <resource-loader name="main" type="component"/>
    <classpath type="dir" location="config"/>

    <!-- Entity model: grade levels, staff positions, promotions, leave records -->
    <entity-resource type="model" reader-name="main" loader="main" location="entitydef/entitymodel.xml"/>

    <!-- Seed data: permissions, security group, enumerations, status types -->
    <entity-resource type="data" reader-name="seed" loader="main" location="data/seed/HmoHrSeedData.xml"/>

    <!-- Service definitions -->
    <service-resource type="model" loader="main" location="servicedef/services.xml"/>

    <!--
        HMO HR & Admin webapp
        base-permission="OFBTOOLS,HMO_VIEW" — internal staff app accessed via admin tools.
    -->
    <webapp name="hmohr"
        title="HMO HR &amp; Admin"
        position="24"
        description="HMO HR and Administration Application"
        server="default-server"
        location="webapp/hmohr"
        base-permission="OFBTOOLS,HMO_VIEW"
        mount-point="/hmohr"
        app-shortcut-screen="component://hmo-hr/widget/CommonScreens.xml#ShortcutApp"
        app-bar-display="true"/>

</ofbiz-component>
