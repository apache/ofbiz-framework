<!--
    hmo-finance — HMO Finance & Accounting

    Depends on the OFBiz accounting application.
    Provides the /hmofinance webapp for internal finance staff to:
      - Invoice sponsors for monthly/annual premiums (HmoPremiumInvoice)
      - Disburse batch claim payments to providers (HmoClaimPayment)
      - Manage capitation schedules for primary-care providers
      - Generate financial reports (premiums collected vs claims paid)
-->
<ofbiz-component name="hmo-finance"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://ofbiz.apache.org/dtds/ofbiz-component.xsd">

    <resource-loader name="main" type="component"/>
    <classpath type="dir" location="config"/>

    <!-- Entity model: premium invoices, claim payments, capitation schedules -->
    <entity-resource type="model" reader-name="main" loader="main" location="entitydef/entitymodel.xml"/>

    <!-- Seed data: status types, security groups -->
    <entity-resource type="data" reader-name="seed" loader="main" location="data/seed/HmoFinanceSeedData.xml"/>

    <!-- Service definitions -->
    <service-resource type="model" loader="main" location="servicedef/services.xml"/>

    <!--
        HMO Finance webapp
        base-permission="OFBTOOLS,HMO_VIEW" — internal finance officers.
    -->
    <webapp name="hmofinance"
        title="HMO Finance &amp; Accounting"
        position="25"
        description="HMO Finance and Accounting"
        server="default-server"
        location="webapp/hmofinance"
        base-permission="OFBTOOLS,HMO_VIEW"
        mount-point="/hmofinance"
        app-bar-display="true"
        app-shortcut-screen="component://hmo-finance/widget/CommonScreens.xml#ShortcutApp"/>

</ofbiz-component>
