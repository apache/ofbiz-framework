<!--
    HMO Plugin Suite - Component Load Order
    
    hmo-ehdsi is loaded first because it defines the shared service library
    (checkMemberEligibility, getActiveCoverage) consumed by the other plugins,
    and hosts both the member self-service portal (/hmomember) and the internal
    HMO management application (/hmomgmt).
    
    hmo-provider defines the claim/pre-authorisation entity models and portal.
    hmo-sponsor defines the enrollment/policy entity models and corporate portal.
    hmo-hr extends the humanres application for HMO internal staff management.
    hmo-finance extends the accounting application for HMO financial operations.
    hmo-admin is loaded last (position 26) — it is a read-only super-admin
    dashboard that aggregates KPIs from all five plugins above.
-->
<component-loader xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://ofbiz.apache.org/dtds/component-loader.xsd">
    <load-component component-location="hmo-ehdsi"/>
    <load-component component-location="hmo-provider"/>
    <load-component component-location="hmo-sponsor"/>
    <load-component component-location="hmo-hr"/>
    <load-component component-location="hmo-finance"/>
    <load-component component-location="hmo-admin"/>
</component-loader>
