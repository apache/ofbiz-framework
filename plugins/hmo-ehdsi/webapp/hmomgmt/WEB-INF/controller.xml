<site-conf xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://ofbiz.apache.org/Site-Conf"
        xsi:schemaLocation="http://ofbiz.apache.org/Site-Conf http://ofbiz.apache.org/dtds/site-conf.xsd">

    <include location="component://common/webcommon/WEB-INF/common-controller.xml"/>
    <include location="component://common/webcommon/WEB-INF/security-controller.xml"/>
    <description>HMO Internal Management Application Controller</description>

    <!-- ================================================================ -->
    <!--  Default routing                                                  -->
    <!-- ================================================================ -->

    <request-map uri="view">
        <security https="true" auth="true"/>
        <response name="success" type="request" value="main"/>
    </request-map>

    <request-map uri="main">
        <security https="true" auth="true"/>
        <response name="success" type="view" value="main"/>
    </request-map>

    <!-- ================================================================ -->
    <!--  Claims Processing Queue                                          -->
    <!-- ================================================================ -->

    <request-map uri="claimsQueue">
        <security https="true" auth="true"/>
        <response name="success" type="view" value="claimsQueue"/>
    </request-map>

    <request-map uri="viewClaimDetail">
        <security https="true" auth="true"/>
        <response name="success" type="view" value="viewClaimDetail"/>
    </request-map>

    <request-map uri="approveClaim">
        <security https="true" auth="true"/>
        <event type="service" invoke="approveClaim"/>
        <response name="success" type="view" value="claimsQueue"/>
        <response name="error"   type="view" value="viewClaimDetail"/>
    </request-map>

    <request-map uri="rejectClaim">
        <security https="true" auth="true"/>
        <event type="service" invoke="rejectClaim"/>
        <response name="success" type="view" value="claimsQueue"/>
        <response name="error"   type="view" value="viewClaimDetail"/>
    </request-map>

    <request-map uri="markClaimPaid">
        <security https="true" auth="true"/>
        <event type="service" invoke="markClaimPaid"/>
        <response name="success" type="view" value="claimsQueue"/>
        <response name="error"   type="view" value="viewClaimDetail"/>
    </request-map>

    <!-- ================================================================ -->
    <!--  Pre-Authorization Review                                         -->
    <!-- ================================================================ -->

    <request-map uri="preAuthQueue">
        <security https="true" auth="true"/>
        <response name="success" type="view" value="preAuthQueue"/>
    </request-map>

    <request-map uri="viewPreAuth">
        <security https="true" auth="true"/>
        <response name="success" type="view" value="viewPreAuth"/>
    </request-map>

    <request-map uri="approvePreAuthorization">
        <security https="true" auth="true"/>
        <event type="service" invoke="approvePreAuthorization"/>
        <response name="success" type="view" value="preAuthQueue"/>
        <response name="error"   type="view" value="viewPreAuth"/>
    </request-map>

    <request-map uri="denyPreAuthorization">
        <security https="true" auth="true"/>
        <event type="service" invoke="denyPreAuthorization"/>
        <response name="success" type="view" value="preAuthQueue"/>
        <response name="error"   type="view" value="viewPreAuth"/>
    </request-map>

    <!-- ================================================================ -->
    <!--  Member 360 View                                                  -->
    <!-- ================================================================ -->

    <request-map uri="findMember">
        <security https="true" auth="true"/>
        <response name="success" type="view" value="findMember"/>
    </request-map>

    <request-map uri="viewMember360">
        <security https="true" auth="true"/>
        <response name="success" type="view" value="viewMember360"/>
    </request-map>

    <!-- ================================================================ -->
    <!--  Sponsor Management                                               -->
    <!-- ================================================================ -->

    <request-map uri="sponsorList">
        <security https="true" auth="true"/>
        <response name="success" type="view" value="sponsorList"/>
    </request-map>

    <request-map uri="viewSponsor">
        <security https="true" auth="true"/>
        <response name="success" type="view" value="viewSponsor"/>
    </request-map>

    <!-- ================================================================ -->
    <!--  Provider Network Management                                      -->
    <!-- ================================================================ -->

    <request-map uri="providerList">
        <security https="true" auth="true"/>
        <response name="success" type="view" value="providerList"/>
    </request-map>

    <request-map uri="viewProvider">
        <security https="true" auth="true"/>
        <response name="success" type="view" value="viewProvider"/>
    </request-map>

    <!-- ================================================================ -->
    <!--  Reports                                                          -->
    <!-- ================================================================ -->

    <request-map uri="reports">
        <security https="true" auth="true"/>
        <response name="success" type="view" value="reports"/>
    </request-map>

    <!-- ================================================================ -->
    <!--  View Mappings                                                    -->
    <!-- ================================================================ -->

    <view-map name="main"           type="screen" page="component://hmo-ehdsi/widget/mgmt/MgmtScreens.xml#MgmtDashboard"/>
    <view-map name="claimsQueue"    type="screen" page="component://hmo-ehdsi/widget/mgmt/MgmtScreens.xml#ClaimsQueue"/>
    <view-map name="viewClaimDetail" type="screen" page="component://hmo-ehdsi/widget/mgmt/MgmtScreens.xml#ViewClaimDetail"/>
    <view-map name="preAuthQueue"   type="screen" page="component://hmo-ehdsi/widget/mgmt/MgmtScreens.xml#PreAuthQueue"/>
    <view-map name="viewPreAuth"    type="screen" page="component://hmo-ehdsi/widget/mgmt/MgmtScreens.xml#ViewPreAuth"/>
    <view-map name="findMember"     type="screen" page="component://hmo-ehdsi/widget/mgmt/MgmtScreens.xml#FindMember"/>
    <view-map name="viewMember360"  type="screen" page="component://hmo-ehdsi/widget/mgmt/MgmtScreens.xml#ViewMember360"/>
    <view-map name="sponsorList"    type="screen" page="component://hmo-ehdsi/widget/mgmt/MgmtScreens.xml#SponsorList"/>
    <view-map name="viewSponsor"    type="screen" page="component://hmo-ehdsi/widget/mgmt/MgmtScreens.xml#ViewSponsor"/>
    <view-map name="providerList"   type="screen" page="component://hmo-ehdsi/widget/mgmt/MgmtScreens.xml#ProviderList"/>
    <view-map name="viewProvider"   type="screen" page="component://hmo-ehdsi/widget/mgmt/MgmtScreens.xml#ViewProvider"/>
    <view-map name="reports"        type="screen" page="component://hmo-ehdsi/widget/mgmt/MgmtScreens.xml#Reports"/>

</site-conf>
