<!--
    hmo-ehdsi Seed Data
    
    Assigns the OFBTOOLS_VIEW permission to the HMO_PROVIDER_GRP and HMO_ENROLLEE_GRP
    security groups so that users can log in to OFBiz webapps that require the standard
    OFBiz session setup (even non-OFBTOOLS portals need ContextFilter to function).
    The groups HMO_ADMIN and HMO_CLAIMS_GRP already have OFBTOOLS_VIEW assigned in
    HmoDemoData.xml, so only the remaining groups need it here as seed (not demo) data.
-->
<entity-engine-xml>

    <!--
        Security permission for hmo-ehdsi webapps.
        HMO_MGMT guards the internal management application's app-bar entry.
    -->
    <SecurityPermission permissionId="HMO_MGMT" description="HMO internal management application access"/>
    <SecurityPermission permissionId="HMO_MEMBER" description="HMO member self-service portal access"/>
    <SecurityPermission permissionId="HMO_SPONSOR_ACCESS" description="HMO sponsor portal access"/>
    <SecurityPermission permissionId="HMO_PROVIDER_ACCESS" description="HMO provider portal access"/>

</entity-engine-xml>
