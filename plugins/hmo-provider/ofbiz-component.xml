<!--
    hmo-provider — Healthcare Provider Portal
    
    Provides the /hmoprovider webapp for hospitals, clinics, pharmacies, and
    laboratories to:
      - Verify enrollee eligibility
      - Submit pre-authorisation requests
      - Submit and track claims
      - View payment status and remittance
    
    Entity model defines: HmoPreAuthorization, HmoClaim, HmoClaimLine,
                          HmoClaimDocument
-->
<ofbiz-component name="hmo-provider"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://ofbiz.apache.org/dtds/ofbiz-component.xsd">

    <resource-loader name="main" type="component"/>
    <classpath type="dir" location="config"/>

    <!-- Entity model: claim and pre-authorisation entities -->
    <entity-resource type="model" reader-name="main" loader="main" location="entitydef/entitymodel.xml"/>

    <!-- Seed data: ICD-10 and CPT reference codes -->
    <entity-resource type="data" reader-name="seed" loader="main" location="data/seed/HmoProviderSeedData.xml"/>

    <!-- Service definitions -->
    <service-resource type="model" loader="main" location="servicedef/services.xml"/>

    <!--
        Provider Portal webapp
        base-permission="HMO_PROVIDER_VIEW" — only provider security group users
        can access this portal.
    -->
    <webapp name="hmoprovider"
        title="HMO Provider Portal"
        position="22"
        description="HMO Healthcare Provider Portal"
        server="default-server"
        location="webapp/hmoprovider"
        base-permission="HMO_PROVIDER_VIEW"
        mount-point="/hmoprovider"
        app-bar-display="false"/>

</ofbiz-component>
