<!--
    hmo-admin — HMO Super Administrative Dashboard

    Loaded last (position 26) so every entity and service from the five
    other HMO plugins is already registered when this component starts.

    This component introduces NO new entities — it is a pure read/aggregate
    layer over the entities owned by hmo-ehdsi, hmo-provider, hmo-sponsor,
    hmo-hr, and hmo-finance.  The single Groovy service aggregates KPI
    counts for the dashboard screen.
-->
<ofbiz-component name="hmo-admin"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://ofbiz.apache.org/dtds/ofbiz-component.xsd">

    <resource-loader name="main" type="component"/>
    <classpath type="dir" location="config"/>

    <!-- Seed data: super-admin security group + permissions -->
    <entity-resource type="data" reader-name="seed" loader="main" location="data/seed/HmoAdminSeedData.xml"/>

    <!-- Service definitions -->
    <service-resource type="model" loader="main" location="servicedef/services.xml"/>

    <!--
        HMO Admin webapp
        base-permission="OFBTOOLS,HMO_ADMIN" — only super-admins may access this portal.
    -->
    <webapp name="hmoadmin"
        title="HMO Administration"
        position="26"
        description="HMO Super Administrative Dashboard"
        server="default-server"
        location="webapp/hmoadmin"
        base-permission="OFBTOOLS,HMO_ADMIN"
        mount-point="/hmoadmin"
        app-bar-display="true"
        app-shortcut-screen="component://hmo-admin/widget/CommonScreens.xml#ShortcutApp"/>

</ofbiz-component>
