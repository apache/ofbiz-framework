<site-conf xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://ofbiz.apache.org/Site-Conf"
        xsi:schemaLocation="http://ofbiz.apache.org/Site-Conf http://ofbiz.apache.org/dtds/site-conf.xsd">

    <include location="component://common/webcommon/WEB-INF/common-controller.xml"/>
    <description>HMO Administration Controller</description>

    <request-map uri="view">
        <security https="true" auth="true"/>
        <response name="success" type="request" value="main"/>
    </request-map>

    <!-- ================================================================ -->
    <!--  Main Dashboard                                                  -->
    <!-- ================================================================ -->

    <request-map uri="main">
        <security https="true" auth="true"/>
        <response name="success" type="view" value="main"/>
    </request-map>

    <!-- ================================================================ -->
    <!--  Enrollment Overview                                             -->
    <!-- ================================================================ -->

    <request-map uri="enrollmentOverview">
        <security https="true" auth="true"/>
        <response name="success" type="view" value="enrollmentOverview"/>
    </request-map>

    <!-- ================================================================ -->
    <!--  Claim Overview                                                  -->
    <!-- ================================================================ -->

    <request-map uri="claimOverview">
        <security https="true" auth="true"/>
        <response name="success" type="view" value="claimOverview"/>
    </request-map>

    <!-- ================================================================ -->
    <!--  Provider Overview                                               -->
    <!-- ================================================================ -->

    <request-map uri="providerOverview">
        <security https="true" auth="true"/>
        <response name="success" type="view" value="providerOverview"/>
    </request-map>

    <!-- ================================================================ -->
    <!--  Sponsor Overview                                                -->
    <!-- ================================================================ -->

    <request-map uri="sponsorOverview">
        <security https="true" auth="true"/>
        <response name="success" type="view" value="sponsorOverview"/>
    </request-map>

    <!-- ================================================================ -->
    <!--  HR &amp; Staff Overview                                         -->
    <!-- ================================================================ -->

    <request-map uri="staffOverview">
        <security https="true" auth="true"/>
        <response name="success" type="view" value="staffOverview"/>
    </request-map>

    <!-- ================================================================ -->
    <!--  Finance Overview                                                -->
    <!-- ================================================================ -->

    <request-map uri="financeOverview">
        <security https="true" auth="true"/>
        <response name="success" type="view" value="financeOverview"/>
    </request-map>

    <!-- ================================================================ -->
    <!--  Sponsor Approval & Delisting                                   -->
    <!-- ================================================================ -->

    <request-map uri="approveSponsorPolicy">
        <security https="true" auth="true"/>
        <event type="service" invoke="approveSponsorPolicy"/>
        <response name="success" type="view" value="sponsorOverview"/>
        <response name="error"   type="view" value="sponsorOverview"/>
    </request-map>

    <request-map uri="delistSponsor">
        <security https="true" auth="true"/>
        <event type="service" invoke="delistSponsor"/>
        <response name="success" type="view" value="sponsorOverview"/>
        <response name="error"   type="view" value="sponsorOverview"/>
    </request-map>

    <!-- ================================================================ -->
    <!--  Facility Approval & Delisting                                   -->
    <!-- ================================================================ -->

    <request-map uri="approveFacility">
        <security https="true" auth="true"/>
        <event type="service" invoke="approveFacility"/>
        <response name="success" type="view" value="providerOverview"/>
        <response name="error"   type="view" value="providerOverview"/>
    </request-map>

    <request-map uri="delistFacility">
        <security https="true" auth="true"/>
        <event type="service" invoke="delistFacility"/>
        <response name="success" type="view" value="providerOverview"/>
        <response name="error"   type="view" value="providerOverview"/>
    </request-map>

    <!-- ================================================================ -->
    <!--  Claim Payment Approval                                          -->
    <!-- ================================================================ -->

    <request-map uri="approveClaimPayment">
        <security https="true" auth="true"/>
        <event type="service" invoke="approveClaimPayment"/>
        <response name="success" type="view"    value="financeOverview"/>
        <response name="error"   type="view"    value="financeOverview"/>
    </request-map>

    <!-- ================================================================ -->
    <!--  Audit Log                                                       -->
    <!-- ================================================================ -->

    <request-map uri="auditLog">
        <security https="true" auth="true"/>
        <response name="success" type="view" value="auditLog"/>
    </request-map>

    <!-- ================================================================ -->
    <!--  View Mappings                                                   -->
    <!-- ================================================================ -->

    <view-map name="main"               type="screen" page="component://hmo-admin/widget/AdminScreens.xml#AdminDashboard"/>
    <view-map name="enrollmentOverview" type="screen" page="component://hmo-admin/widget/AdminScreens.xml#EnrollmentOverview"/>
    <view-map name="claimOverview"      type="screen" page="component://hmo-admin/widget/AdminScreens.xml#ClaimOverview"/>
    <view-map name="providerOverview"   type="screen" page="component://hmo-admin/widget/AdminScreens.xml#ProviderOverview"/>
    <view-map name="sponsorOverview"    type="screen" page="component://hmo-admin/widget/AdminScreens.xml#SponsorOverview"/>
    <view-map name="staffOverview"      type="screen" page="component://hmo-admin/widget/AdminScreens.xml#StaffOverview"/>
    <view-map name="financeOverview"    type="screen" page="component://hmo-admin/widget/AdminScreens.xml#FinanceOverview"/>
    <view-map name="auditLog"           type="screen" page="component://hmo-admin/widget/AdminScreens.xml#AuditLog"/>

</site-conf>
