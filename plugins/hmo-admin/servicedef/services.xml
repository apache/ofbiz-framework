<!--
    hmo-admin Service Definitions

    Aggregate dashboard:
        getAdminDashboardStats — queries every HMO entity and returns KPI counts
-->
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://ofbiz.apache.org/dtds/services.xsd">
    <description>HMO Admin Services</description>
    <vendor>HMO</vendor>
    <version>1.0</version>

    <!-- ================================================================ -->
    <!--  Admin Dashboard Aggregation                                     -->
    <!-- ================================================================ -->

    <service name="getAdminDashboardStats" engine="groovy" auth="true"
            location="component://hmo-admin/src/main/groovy/org/apache/ofbiz/hmo/admin/AdminDashboardService.groovy"
            invoke="getAdminDashboardStats">
        <description>Aggregate KPI counts and financial totals across all HMO plugins
            for the super-admin dashboard. Requires HMO_ADMIN permission.</description>
        <permission-service service-name="hmoPermissionCheck" main-action="ADMIN"/>

        <!-- Enrollment KPIs -->
        <attribute name="totalEnrollments"      mode="OUT" type="Long"/>
        <attribute name="activeEnrollments"     mode="OUT" type="Long"/>
        <attribute name="suspendedEnrollments"  mode="OUT" type="Long"/>
        <attribute name="terminatedEnrollments" mode="OUT" type="Long"/>

        <!-- Claim KPIs -->
        <attribute name="totalClaims"    mode="OUT" type="Long"/>
        <attribute name="pendingClaims"  mode="OUT" type="Long"/>
        <attribute name="approvedClaims" mode="OUT" type="Long"/>
        <attribute name="paidClaims"     mode="OUT" type="Long"/>
        <attribute name="rejectedClaims" mode="OUT" type="Long"/>

        <!-- Pre-authorisation KPIs -->
        <attribute name="totalPreAuths"    mode="OUT" type="Long"/>
        <attribute name="pendingPreAuths"  mode="OUT" type="Long"/>
        <attribute name="approvedPreAuths" mode="OUT" type="Long"/>

        <!-- Sponsor KPIs -->
        <attribute name="totalSponsorPolicies"  mode="OUT" type="Long"/>
        <attribute name="activeSponsorPolicies" mode="OUT" type="Long"/>

        <!-- Provider KPIs -->
        <attribute name="totalProviders" mode="OUT" type="Long"/>

        <!-- HR KPIs -->
        <attribute name="totalStaffPositions" mode="OUT" type="Long"/>
        <attribute name="activeStaff"         mode="OUT" type="Long"/>
        <attribute name="staffOnLeave"        mode="OUT" type="Long"/>
        <attribute name="pendingLeaves"       mode="OUT" type="Long"/>
        <attribute name="approvedLeaves"      mode="OUT" type="Long"/>

        <!-- Finance KPIs -->
        <attribute name="pendingInvoices"       mode="OUT" type="Long"/>
        <attribute name="paidInvoices"          mode="OUT" type="Long"/>
        <attribute name="overdueInvoices"       mode="OUT" type="Long"/>
        <attribute name="totalPremiumCollected" mode="OUT" type="BigDecimal"/>
        <attribute name="pendingPayments"       mode="OUT" type="Long"/>
        <attribute name="processedPayments"     mode="OUT" type="Long"/>
        <attribute name="totalClaimsPaid"       mode="OUT" type="BigDecimal"/>
    </service>

</services>
